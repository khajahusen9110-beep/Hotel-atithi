// Cloudflare Workers deploy config (Workers Builds runs `npx wrangler deploy` after `npm run build`).
// The app is a static Vite SPA: no Worker script, just the built files in ./dist.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hotel-atithi",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths (/cart, /order/123, ...) serve index.html so React Router can handle them
    "not_found_handling": "single-page-application"
  }
}
